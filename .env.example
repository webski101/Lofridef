# Gemini (Google AI Studio) — preferred for lofridef local/dev
# Get a key: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional Gemini model id
LOFRIDEF_MODEL=gemini-3-flash-preview

# Optional: Vercel AI Gateway instead of a direct Gemini key
AI_GATEWAY_API_KEY=

# Without a live key, lofridef runs in grounded demo mode.
